# ---------------------------------------------------------------------------
# Copy to .env for local development, and set the same keys in Netlify under
# Site configuration → Environment variables for production.
# ---------------------------------------------------------------------------

# Database (required) --------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *pooled* connection (port 6543) for the app: serverless functions open
# a lot of short-lived connections and the pooler is what survives that.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# The SESSION pooler (port 5432), used only by `prisma migrate deploy`.
# Migrations can't run through the transaction pooler. Do not use the
# db.<ref>.supabase.co direct host here — it is IPv6-only without the IPv4
# add-on, and most CI/build environments are IPv4.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Auth (required in production) ----------------------------------------------
# The single shared password for the app. If this is unset the app runs open in
# development and refuses to serve anything in production.
AUTH_PASSWORD="choose-a-long-random-passphrase"

# Signs the session cookie. Set it so that changing the password doesn't have to
# invalidate every session (and vice versa). Any long random string works:
#   openssl rand -base64 32
AUTH_SECRET=""

# Creative uploads (required in production) ----------------------------------
# Netlify has no persistent writable disk, so uploads go to Supabase Storage.
# Leave these unset locally and uploads fall back to ./public/uploads.
# Create a PUBLIC bucket named `creative` in Supabase → Storage.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="creative"

# Reader survey (required for /survey) ---------------------------------------
# A DIFFERENT Supabase project from the one above: the public newsletter site
# collects the reader survey into its own project, and the /survey page reads
# the `survey_responses` table from it. Leave unset and the page explains what
# is missing instead of erroring.
#
# This must be the service_role key, not the anon/publishable key.
# `survey_responses` has RLS on with an INSERT-only policy for `anon` — the
# public site can post a response but nobody can read one back, which is the
# right shape for a table of reader demographics. The anon key therefore returns
# zero rows. The service-role key is used server-side only and is never sent to
# the browser. Do not add a public SELECT policy to work around this: that would
# expose every response to anyone holding the anon key.
SURVEY_SUPABASE_URL="https://SURVEY_PROJECT_REF.supabase.co"
SURVEY_SUPABASE_SERVICE_ROLE_KEY=""

# Business directory rebuild (optional) --------------------------------------
# thetidelanding's Astro build reads the DirectoryListing table at build time,
# so a listing added or removed on /directory doesn't reach the public site
# until thetidelanding rebuilds. Set this to a Netlify build hook on
# thetidelanding's site to trigger that rebuild automatically after every
# save/delete: thetidelanding's Netlify site → Site configuration →
# Build & deploy → Build hooks → create one (e.g. named "Directory listing
# changed") and paste the URL here. Leave unset and saves/deletes still work
# locally and in production — they just won't kick off a rebuild, so the
# public site catches up at its next scheduled or manual deploy instead.
THETIDELANDING_BUILD_HOOK_URL=""
