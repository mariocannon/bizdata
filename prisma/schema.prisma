// The Tide — Ad Manager
//
// Enumerated values are modelled as String and constrained in the app with Zod
// + TypeScript unions (lib/enums.ts). This keeps the schema portable across
// engines and keeps one source of truth for the allowed values.
//
// Postgres (Supabase in production). Nothing outside this file knows which
// engine is in use, so swapping providers never touches application code.

generator client {
  provider = "prisma-client-js"
  // "native" is this machine; Netlify Functions run on Amazon Linux, which
  // needs the rhel engine. Without it the deployed app throws at the first
  // query — Prisma finds no engine it can load.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // The app connects through Supabase's transaction pooler; migrations need a
  // direct connection, which the pooler can't carry. Locally both point at the
  // same database.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Advertiser {
  id             String    @id @default(cuid())
  name           String
  category       String // AdvertiserCategory union
  status         String    @default("PROSPECT") // AdvertiserStatus union
  contactName    String?
  email          String?
  phone          String?
  website        String?
  reviewsChecked Boolean   @default(false)
  lastContacted  DateTime?
  notes          String?
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Issue {
  id          String       @id @default(cuid())
  title       String // e.g. "The Tide — 14 Aug 2025"
  publishDate DateTime
  status      String       @default("PLANNING") // IssueStatus union
  theme       String?
  bookings    Booking[]
  classifieds Classified[]
  events      Event[]
  jobs        Job[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Booking {
  id           String     @id @default(cuid())
  label        String // "Example Realty – Headline – 14 Aug"
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id])
  advertiserId String
  issue        Issue      @relation(fields: [issueId], references: [id])
  issueId      String
  adType       String // AdType union
  section      String? // SectionSlot union — required when adType = SECTION_SPONSOR
  price        Float      @default(0)
  status       String     @default("RESERVED") // BookingStatus union
  paid         String     @default("UNPAID") // PaidStatus union
  ctaUrl       String?
  copy         String?
  creativeUrl  String? // path/URL to uploaded image
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([issueId])
  @@index([advertiserId])
}

// A short reader-submitted listing in the classifieds section: a headline, up
// to 70 words and a way to reply. Deliberately not a Booking — a classified is not
// sold to an advertiser in the CRM and does not consume bulletin inventory, so
// giving it its own table keeps both models honest.
//
// issueId is optional: listings are collected before they are placed, and an
// unplaced one sits in the queue until an issue is picked.
// `featured` is the same paid upgrade an Event carries, and for the same flat
// fee: an image above the copy, and the top of the exported block. The fee is
// copied onto the row rather than read from FEATURED_FEE at display time, so
// raising the price never rewrites what somebody was already charged.
model Classified {
  id           String   @id @default(cuid())
  headline     String
  body         String // up to 70 words, enforced once approved (lib/classifieds.ts)
  category     String // ClassifiedCategory union
  status       String   @default("DRAFT") // ClassifiedStatus union
  source       String   @default("STAFF") // ClassifiedSource union — STAFF or PUBLIC (/submit)
  featured     Boolean  @default(false)
  imageUrl     String? // path/URL to the uploaded image — featured listings only
  featuredFee  Float    @default(0) // what was charged, at the time it was charged
  featuredPaid String   @default("UNPAID") // PaidStatus union
  contactName  String?
  contactEmail String?
  contactPhone String?
  issue        Issue?   @relation(fields: [issueId], references: [id])
  issueId      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([issueId])
}

// A community event listing: a classified with a date on it. Same copy rules
// (lib/events.ts shares the 70-word cap), plus when and where.
//
// Midnight on startsAt/endsAt means "no time given" — the form has a date field
// and a separate optional time field, so a market that just runs "on Saturday"
// reads as a date rather than as 12am.
//
// `featured` is the one paid upgrade a listing can carry: an image above the
// copy, for a flat fee. The fee is copied onto the row rather than read from
// FEATURED_EVENT_FEE at display time, so raising the price never rewrites what
// somebody was already charged.
model Event {
  id           String    @id @default(cuid())
  title        String
  body         String // up to 70 words, enforced once approved
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  category     String // EventCategory union
  status       String    @default("DRAFT") // EventStatus union
  source       String    @default("STAFF") // ClassifiedSource union — STAFF or PUBLIC (/submit/event)
  featured     Boolean   @default(false)
  imageUrl     String? // path/URL to the uploaded image — featured listings only
  featuredFee  Float     @default(0) // what was charged, at the time it was charged
  featuredPaid String    @default("UNPAID") // PaidStatus union
  contactName  String?
  contactEmail String?
  contactPhone String?
  ticketUrl    String?
  issue        Issue?    @relation(fields: [issueId], references: [id])
  issueId      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([issueId])
  // Every list and the export are ordered by date, so it earns an index.
  @@index([startsAt])
}

// A single business listing in the Hibiscus Coast business directory
// (thetidelanding's /hibiscus-coast-business-directory). Categories and towns
// are hand-kept unions (lib/enums.ts) that must match thetidelanding's slugs
// and copy exactly — thetidelanding's Astro build reads this table at build
// time over PostgREST (anon key, same Supabase project) and does not import
// from this app, so the field names here are the contract between the two.
// thetidelanding's build query must filter to `status = 'PUBLISHED'` — a
// PENDING row is a submission awaiting review, not yet public.
//
// Two states only, unlike Classified/Event's four — this is evergreen
// website content with no issue/newsletter lifecycle to move through:
//
//   - PENDING   a public submission (source=PUBLIC) awaiting operator review.
//     Not shown on the public site. There is no REJECTED status — rejecting
//     one is just deleting the row (deleteDirectoryListing).
//   - PUBLISHED live on the public site. The default for every row, so a
//     staff-added listing (source=STAFF) goes live immediately, exactly as
//     before this column existed.
//
// `featured` stays staff-only regardless of source: a public submission can
// never set itself featured (enforced by the insert policy on thetidelanding's
// side, not by this schema), and approving a PENDING row never sets it either
// — the operator turns it on afterwards, same flow as it works today.
//
// Three invariants are enforced server-side rather than in the schema,
// because Prisma/Postgres can't express any of them as a constraint without a
// trigger:
//
//   - at most 10 PUBLISHED listings per category (an add, an edit, or an
//     approval that would exceed it is rejected outright, never silently
//     truncated — PENDING rows don't count towards this, so a backlog of
//     submissions can't block the operator's live slots or its own approval)
//   - at most one `featured` listing per category, kept true by unsetting
//     every other listing in the category inside the same transaction as the
//     write that sets this one — see lib/directory.ts and
//     app/(app)/directory/actions.ts.
//   - saving an existing row (staff or a pending public one) never changes its
//     status or source — only approveDirectoryListing moves PENDING to
//     PUBLISHED.
model DirectoryListing {
  id           String   @id @default(cuid())
  name         String
  category     String // DirectoryCategory union (lib/enums.ts) — matches thetidelanding's category slugs exactly
  town         String // DirectoryTown union (lib/enums.ts) — matches thetidelanding's towns list exactly
  blurb        String
  phone        String?
  url          String?
  featured     Boolean  @default(false)
  status       String   @default("PUBLISHED") // PENDING | PUBLISHED — see comment above
  source       String   @default("STAFF") // ClassifiedSource union — STAFF or PUBLIC (public submission form, built separately)
  contactName  String? // public submitter only — so the operator can follow up before/instead of approving
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  // The "awaiting review" queue and thetidelanding's build query both filter
  // on this.
  @@index([status])
}

// A paid job listing for "Hibiscus Coast Jobs" — an employer's open role, run
// on thetidelanding's /hibiscus-coast-jobs page and in the newsletter's Jobs
// block for 30 days. Column for column this is a Classified with a hire on it:
// same DRAFT→APPROVED→PUBLISHED→ARCHIVED lifecycle, same STAFF/PUBLIC source,
// same optional issueId + contact columns. What's new is the hire itself
// (employer, jobType, town, pay, applyUrl, closesAt) and that the base listing
// is *paid* — so unlike Classified's separate featured-fee track, a Job carries
// one `tier` + one snapshotted `price` + one `paid` state, the same three-state
// chase a Booking uses. See lib/jobs.ts for pricing and lib/enums.ts for the
// unions.
//
// closesAt is required and always set: the public form defaults it to 30 days
// out (lib/jobs.ts defaultClosesAt), the operator can shorten it. thetidelanding's
// build query filters to status = 'PUBLISHED' AND closesAt > now(); the Jobs
// block and every list order by it.
//
// logoUrl is the FEATURED tier's upgrade, exactly as Classified.imageUrl is the
// featured classified's — staff-only, checked in the server action (a File
// can't reach the schema), never set by a public submission.
//
// There is deliberately no childcare / in-home-care JobCategory: those roles
// are excluded from the board (operator decision, 8 Sep 2026), so the taxonomy
// gives them no bucket and moderation catches anything filed under OTHER.
model Job {
  id           String    @id @default(cuid())
  title        String // the role, e.g. "Weekend barista"
  employer     String // the hiring business or organisation
  body         String // up to 70 words, enforced once approved (lib/jobs.ts)
  category     String // JobCategory union
  jobType      String // JobType union — CASUAL | PART_TIME | FULL_TIME | FIXED_TERM | CONTRACT
  town         String // DirectoryTown union — reuses the directory's town list
  pay          String? // free text, e.g. "$24–$27/hr" — optional
  applyUrl     String? // "apply online" link — optional
  status       String    @default("DRAFT") // JobStatus union
  source       String    @default("STAFF") // ClassifiedSource union — STAFF or PUBLIC (/submit/job)
  tier         String    @default("STANDARD") // JobTier union — STANDARD | FEATURED | COMMUNITY
  price        Float     @default(0) // what was charged for this listing, at the time it was charged
  paid         String    @default("UNPAID") // PaidStatus union
  logoUrl      String? // employer logo — FEATURED listings only
  closesAt     DateTime // applications close / the listing drops off the board
  contactName  String?
  contactEmail String?
  contactPhone String?
  issue        Issue?    @relation(fields: [issueId], references: [id])
  issueId      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([issueId])
  // The "awaiting review" queue and thetidelanding's build query both filter
  // on this.
  @@index([status])
  // Every list, the export and the public page order by it.
  @@index([closesAt])
}

// Single-row settings (id is always "settings").
model Settings {
  id               String   @id @default("settings")
  bulletinCapacity Int      @default(3)
  soldOutTarget    Int      @default(10)
  defaultPrices    String   @default("{}") // JSON: Record<AdType, number>
  updatedAt        DateTime @updatedAt
}
